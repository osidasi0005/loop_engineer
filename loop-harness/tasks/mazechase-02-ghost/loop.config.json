{
  "targetDir": "../../examples/mazechase",
  "promptFile": "./PROMPT.md",
  "progressFile": "./PROGRESS.md",
  "runsDir": "../../runs/mazechase-02-ghost",
  "verify": {
    "command": "node --test test/maze.test.mjs test/ghost.test.mjs",
    "tailLines": 80,
    "timeoutSec": 300
  },
  "agent": {
    "command": "claude",
    "args": [
      "-p",
      "--output-format",
      "json",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Read,Edit,Write,Glob,Grep,Bash(node:*),PowerShell(node:*)",
      "--max-turns",
      "40"
    ],
    "timeoutSec": 1800
  },
  "loop": {
    "maxIterations": 6,
    "maxCostUsd": 3,
    "stuckWarnAfter": 2,
    "stuckStopAfter": 4,
    "doneMarker": "<promise>COMPLETE</promise>"
  }
}
