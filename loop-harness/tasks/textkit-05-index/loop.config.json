{
  "targetDir": "../../examples/textkit",
  "promptFile": "./PROMPT.md",
  "progressFile": "./PROGRESS.md",
  "runsDir": "../../runs/textkit-05-index",
  "verify": {
    "command": "node --test \"test/**/*.test.mjs\"",
    "tailLines": 80,
    "timeoutSec": 300
  },
  "git": {
    "autoCommit": true
  },
  "agent": {
    "command": "claude",
    "args": [
      "-p",
      "--output-format",
      "json",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Read,Edit,Write,Glob,Grep,Bash(node:*),PowerShell(node:*)",
      "--max-turns",
      "30"
    ],
    "timeoutSec": 1200
  },
  "loop": {
    "maxIterations": 6,
    "maxCostUsd": 4,
    "stuckWarnAfter": 2,
    "stuckStopAfter": 4,
    "doneMarker": "<promise>COMPLETE</promise>"
  }
}
